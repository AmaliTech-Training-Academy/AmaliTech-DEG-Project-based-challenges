{
  "info": {
    "name": "Idempotency Gateway Tests",
    "_postman_id": "idempotency-gateway-tests",
    "description": "Test collection for the Idempotency Gateway payment service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Response is OK', function() { pm.expect(pm.response.text()).to.equal('OK'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "First Request (Happy Path)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "test-key-001"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"amount\": 5000, \"currency\": \"RWF\"}"
        },
        "url": "http://localhost:8080/process-payment"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Response contains Charged', function() { pm.expect(pm.response.text()).to.include('Charged 5000 RWF'); });",
              "pm.test('No X-Cache-Hit header', function() { pm.expect(pm.response.headers.has('X-Cache-Hit')).to.be.false; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate Request (Cache Hit)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "test-key-001"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"amount\": 5000, \"currency\": \"RWF\"}"
        },
        "url": "http://localhost:8080/process-payment"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Response contains Charged', function() { pm.expect(pm.response.text()).to.include('Charged 5000 RWF'); });",
              "pm.test('X-Cache-Hit is true', function() { pm.expect(pm.response.headers.get('X-Cache-Hit')).to.equal('true'); });"
            ]
          }
        }
      ]
    }
  ]
}
