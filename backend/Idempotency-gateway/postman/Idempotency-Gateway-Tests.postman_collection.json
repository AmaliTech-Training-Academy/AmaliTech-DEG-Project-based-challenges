{
  "info": {
    "name": "Idempotency Gateway Tests",
    "_postman_id": "idempotency-gateway-tests",
    "description": "Test collection for the Idempotency Gateway payment service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Response is OK', function() { pm.expect(pm.response.text()).to.equal('OK'); });"
            ]
          }
        }
      ]
    }
  ]
}
